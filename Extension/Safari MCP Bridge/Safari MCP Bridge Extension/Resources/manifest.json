{
  "manifest_version": 2,
  "name": "Safari MCP Bridge",
  "version": "1.0",
  "description": "Lets the local safari-mcp server read and drive Safari tabs for Claude Code.",
  "background": { "scripts": ["background.js"], "persistent": true },
  "permissions": ["tabs", "webNavigation", "webRequest", "nativeMessaging", "<all_urls>"],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["main.js"], "run_at": "document_start", "all_frames": true, "world": "MAIN" }
  ]
}
